{
  "id": "marku_ambient_studio",
  "title": "Студия света",
  "description": "Подсветка салона, стробоскоп и световые эффекты на экране iDrive, диагностический тест дальнего света BMW.",
  "version": "1.0.3",
  "vendor": "custom",
  "loggingId": "OASR",
  "iconGlyph": "ambient",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18",
    "mgu-inputgate": "1.1.0",
    "mgu-deploy": "0.7.11"
  },
  "autostart": false,
  "signals": {
    "de.bmw.infotainment.misc.ComfortFunctionIuK": {
      "ambientLightInteriorColour": "w",
      "statusAmbientLightInteriorColour": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "the driving mode: colours by mode",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "day or night: dimmer at night",
      "statusDayNightChangeOver": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: the car's own light",
      "VehicleCondition": "s",
      "vehicleConditionNoCrc": "s"
    },
    "de.bmw.body.Light": {
      "_optional": "the turn signals: that side's lights breathe green",
      "StatusFunctionsIndicators": "s"
    },
    "de.bmw.body.DoorsWindowsRoofMirrors": {
      "_optional": "an open door: its lights red",
      "CentralLockingSystemAndPanelStatus": "s"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "selector position for the stationary headlight test",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "the car's speed: driven (for a car that does not say it is locked and left), and the stationary headlight test",
      "statusCarSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Студия света",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Настройки"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "carKind",
      "label": "Тип двигателя",
      "type": "choice",
      "default": "ice",
      "hidden": true,
      "options": [
        [
          "ice",
          "Бензин или дизель"
        ],
        [
          "hybrid",
          "Подключаемый гибрид"
        ]
      ]
    },
    {
      "key": "follow",
      "label": "Сцена по режиму движения",
      "type": "bool",
      "default": true,
      "hidden": true
    },
    {
      "key": "welcome",
      "label": "Приветственная подсветка при запуске",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "sportPulse",
      "label": "Пульсация в режиме Спорт",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "decorWith",
      "label": "Декоративная подсветка меняет цвет вместе с",
      "type": "choice",
      "default": "upper",
      "options": [
        [
          "upper",
          "Верхней подсветкой"
        ],
        [
          "lower",
          "Нижней подсветкой (как у BMW)"
        ]
      ]
    },
    {
      "key": "nightDim",
      "label": "Приглушать подсветку ночью",
      "type": "bool",
      "default": true
    },
    {
      "key": "keep",
      "label": "Восстанавливать мой цвет при запуске",
      "type": "bool",
      "default": true
    },
    {
      "key": "flashAlerts",
      "label": "Вспышка при переключении передачи",
      "type": "bool",
      "default": true,
      "hidden": true
    },
    {
      "key": "turnGlow",
      "label": "Подсветка при включении поворотника",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "doorRed",
      "label": "Красный свет у открытой двери",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "doorCar",
      "label": "Штатный сигнал открытой двери (G20 / G26)",
      "type": "bool",
      "default": false
    },
    {
      "key": "hazardRed",
      "label": "Красный свет при аварийной сигнализации",
      "type": "bool",
      "default": false,
      "hidden": true
    },
    {
      "key": "drive",
      "label": "Расположение руля",
      "type": "choice",
      "default": "lhd",
      "options": [
        [
          "lhd",
          "Слева"
        ],
        [
          "rhd",
          "Справа"
        ]
      ]
    }
  ]
}
