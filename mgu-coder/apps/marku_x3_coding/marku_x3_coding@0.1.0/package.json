    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "LICENSE",
    "LICENSE.MIT",
    "NOTICE"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "author": "Marku custom local project",
  "license": "GPL-3.0-or-later",
  "mguLocalOnly": true,
  "productName": "Кодировки • X3",
  "mguHmi": [
    "ID7"
  ]
