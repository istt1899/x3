  "description": "X3 G01 coding research catalogue and read-only ECU discovery for BMW ID7",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 10485760,
    "cpuLimit": 15,
    "memoryThresholdKB": 65536,
