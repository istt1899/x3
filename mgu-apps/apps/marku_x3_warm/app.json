{
  "id": "marku_x3_warm",
  "title": "Тёплый старт",
  "description": "Приборы прогрева масла и ОЖ, кольцо готовности и объяснимая рекомендация климата без записи в блоки",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "vendor": "custom",
  "loggingId": "MX3W",
  "iconGlyph": "TS",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineStatus": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Тёплый старт",
      "buttons": [
        ["BTN_REFRESH", "Обновить"],
        ["BTN_SETTINGS", "Настройки"]
      ]
    }
  ],
  "settings": [
    {"key": "threshold", "label": "Порог рекомендации", "type": "number", "unit": "°C", "default": 5,
     "steps": [-10, -5, 0, 5, 10, 15]},
    {"key": "history", "label": "История прогревов", "type": "bool", "default": true},
    {"key": "theme", "label": "Цветовая тема", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Раскладка экрана", "type": "choice", "default": "full",
     "options": [["full", "Во весь экран"], ["standard", "Стандартная"]]},
    {"key": "renderer", "label": "Рендерер", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (по умолчанию)"], ["software", "Программный"]]}
  ]
}
