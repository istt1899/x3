{
  "id": "marku-home-bridge",
  "kind": "tool",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "title": "X3 Home bridge",
  "description": "Local allowlist bridge between the X3 Home MGU app and Home Assistant. Pairing stores the token on the head unit only; the app cannot send arbitrary services.",
  "requires": {
    "mgu-deploy": "0.7.11",
    "jap-node22": "22.23.4",
    "mgu-uplink": "0.7.3"
  },
  "uninstallable": true,
  "internet": true,
  "uids": "state/internet-uids",
  "mguHmi": ["ID7"],
  "files": [
    {"path": "home_bridge.js", "from": "home_bridge.js", "mode": "0644"},
    {"path": "check.sh", "from": "check.sh", "mode": "0755"},
    {"path": "LICENSE", "from": "../../LICENSE", "mode": "0644"},
    {"path": "THIRD_PARTY_LICENSES", "from": "../../THIRD_PARTY_LICENSES", "mode": "0644"}
  ],
  "check": ["check.sh"],
  "units": [
    {"name": "marku-home-bridge.service", "from": "systemd/marku-home-bridge.service"}
  ],
  "enable": [
    {"unit": "marku-home-bridge.service", "target": "multi-user.target"}
  ],
  "recmgr": ["marku-home-bridge"],
  "restart": ["marku-home-bridge.service"]
}
