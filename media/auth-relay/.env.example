# Copy to /etc/mgu-vk-auth-relay.env, owned by root, chmod 0600.
# These are placeholders, deliberately rejected until configured.
PUBLIC_BASE_URL=https://vk-login.example.com
VK_CLIENT_ID=REPLACE_WITH_YOUR_VK_ID_APP_ID
VK_REDIRECT_URI=https://vk-login.example.com/callback
BROKER_API_KEY=<GENERATE_A_PRIVATE_RANDOM_BASE64URL_KEY>
VK_SCOPE=video
PORT=8787
SESSION_TTL_SEC=600
MAX_SESSIONS=128
POLL_INTERVAL_SEC=5
